# Confirmed accurate 2026-09-13 by grepping every real
# `process.env.*` reference in app/ features/ lib/ middleware.ts
# components/ -- this file had drifted badly stale before that (missing
# roughly a dozen vars the app actually reads; see DECISION_LOG.md).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API -- tooling only, NOT read by the app itself
# at runtime. Lets an ACA session apply migrations directly via
# `POST https://api.supabase.com/v1/projects/{ref}/database/query`
# instead of the manual Dashboard SQL Editor. Personal Access Token,
# generated at https://supabase.com/dashboard/account/tokens under the
# correct org (see OPERATIONS_ACCOUNTS.md) -- add it to your own
# .env.local for local migration work; it is never deployed to Vercel.
SUPABASE_ACCESS_TOKEN=

# AI Provider (Gemini) -- PDL-001/PDL-006. PDL-012: an 8-key rotation
# across separate Google accounts is the accepted (ToS-risk-flagged,
# see PDL-012) way to multiply the free tier's per-minute quota. Only
# GEMINI_API_KEY_1 is required; unset slots are simply skipped (see
# lib/ai/gemini-provider.ts loadApiKeys()).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
# Defaults to gemini-2.5-flash if unset -- see DECISION_LOG.md PDL-018
# for the live model-deprecation risk on that default.
# GEMINI_MODEL=

# Cron authentication -- shared secret checked by every /api/cron/* and
# CRON_SECRET-eligible /api/admin/* route (E-6 step 1). Reused rather
# than minted per-feature (PLAN.md, hold-gate-calibration: "one 'is
# this a legitimate scheduled job' fact, one place").
CRON_SECRET=

# Scheduling -- IANA timezone identifier for the internal operations
# clock (lib/cron/schedule-gate.ts). Deliberately never a real value in
# committed code/docs -- a business-location-privacy decision, see
# DECISION_LOG.md. Set your own real value locally; never commit it.
OPERATIONS_TIMEZONE=

# Email (Resend) -- review-queue alerts, P-6.
RESEND_API_KEY=
RESEND_FROM=
# The address review-queue alerts are sent to -- see DECISION_LOG.md
# PDL-016 (Resend's unverified-domain sandbox restriction currently
# limits this to the account owner's own address).
REVIEW_QUEUE_EMAIL=

# PayPal (Sprint 08, P-16/P-18) -- sandbox credentials for local/preview,
# live credentials only ever in Vercel Production.
# PAYPAL_MODE (PDL-079): the server talks to the LIVE PayPal only when PAYPAL_MODE=live AND it runs on Vercel
# Production (VERCEL_ENV=production). Anywhere else it is the sandbox, whatever this says. Leave it unset locally.
PAYPAL_MODE=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# The public address of the site (PDL-079). Optional: it defaults to https://vbj.ai-studio.wiki. Used for the share
# picture, the sitemap, robots.txt and the feed reader's user agent.
NEXT_PUBLIC_SITE_URL=
